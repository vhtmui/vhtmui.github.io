{
	"compilerOptions": {
		"jsx": "react-jsx",
		"allowJs": true,
		"checkJs": false,
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"moduleResolution": "bundler",
		"baseUrl": ".",
		"paths": {
			"@lib/*": ["src/lib/*"],
			"@ui/*": ["src/lib/components/ui/*"],
			"@my/*": ["src/lib/components/my/*"]
		}
	},
	"include": ["src"]
}
